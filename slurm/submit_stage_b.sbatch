#!/bin/bash
# =============================================================================
# Stage B production launcher — SLURM job array, throttled to 10 parallel.
# =============================================================================
# Why an array (not 270 separate sbatch calls):
#   - Native scheduler throttling via `--array=1-270%10` keeps only 10 jobs
#     running at a time, regardless of cluster load. Friendlier to the QOS
#     limits than dumping 270 jobs into the queue.
#   - Single submit, single squeue line to monitor: `squeue -u $USER | grep b`.
#   - Re-submit failed indices trivially: identify failed array indices in the
#     logs, then `sbatch --array=42,99,153 slurm/submit_stage_b.sbatch`.
#
# Each $SLURM_ARRAY_TASK_ID decodes one (seed, hospital, task, method) tuple
# by reading line N of slurm/stage_b_jobs.tsv (generated by
# slurm/generate_stage_b_jobs.py).
#
# Dispatch logic mirrors run_baseline.sbatch's case statement, so the two
# share the same per-method CLI flags. Edit run_baseline.sbatch's args first
# if you're tuning, then mirror here.
#
# Usage (after generating the TSV):
#   python slurm/generate_stage_b_jobs.py
#   sbatch slurm/submit_stage_b.sbatch
#     # → submits all 270 with %10 throttle from this file's header.
#   # OR override the array range:
#   sbatch --array=1-50%10 slurm/submit_stage_b.sbatch   # just first 50
#   sbatch --array=42,99,153 slurm/submit_stage_b.sbatch # re-run 3 failed
# =============================================================================
#SBATCH --job-name=b
#SBATCH --array=1-270%10
#SBATCH --mail-type=END,FAIL
#SBATCH --mail-user=lideyi@ufl.edu
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --mem-per-cpu=16gb
#SBATCH --partition=hpg-turin
#SBATCH --gres=gpu:l4:1
#SBATCH --time=12:00:00
# --output / --error include %A (array master job id) and %a (array index)
# so each of the 270 sub-jobs gets its own log file. Without %a they'd all
# write to the same file → instant data loss.
#SBATCH --output=/blue/mei.liu/lideyi/MAS-NAS/slurm_logs/stage_b_%A_%a.out
#SBATCH --error=/blue/mei.liu/lideyi/MAS-NAS/slurm_logs/stage_b_%A_%a.err

set -euo pipefail

mkdir -p /blue/mei.liu/lideyi/MAS-NAS/slurm_logs

# -----------------------------------------------------------------------------
# Decode this array index → (seed, hospital, task, method)
# -----------------------------------------------------------------------------
JOBS_TSV=/home/lideyi/MAS-NAS/slurm/stage_b_jobs.tsv
if [[ ! -f "$JOBS_TSV" ]]; then
    echo "ERROR: $JOBS_TSV missing. Run: python slurm/generate_stage_b_jobs.py"
    exit 1
fi

LINE=$(awk -v n="$SLURM_ARRAY_TASK_ID" 'NR==n' "$JOBS_TSV")
if [[ -z "$LINE" ]]; then
    echo "ERROR: TSV line $SLURM_ARRAY_TASK_ID is empty/missing."
    exit 1
fi

SEED=$(echo "$LINE" | cut -f1)
HOSPITAL=$(echo "$LINE" | cut -f2)
TASK=$(echo "$LINE" | cut -f3)
METHOD=$(echo "$LINE" | cut -f4)

date
hostname
echo "ARRAY_INDEX=$SLURM_ARRAY_TASK_ID  SEED=$SEED  HOSPITAL=$HOSPITAL  TASK=$TASK  METHOD=$METHOD"

# -----------------------------------------------------------------------------
# Env setup (same as run_baseline.sbatch — relies on Python load_dotenv to
# pick up OPENROUTER_API_KEY from /home/lideyi/MAS-NAS/.env)
# -----------------------------------------------------------------------------
module load conda
conda activate Autoformer
cd /home/lideyi/MAS-NAS

# -----------------------------------------------------------------------------
# Per-method CLI dispatch — MIRRORS run_baseline.sbatch case statement.
# If you tweak args in one file, MIRROR THEM HERE OR THE ABLATION COMPARISON
# WILL BE INVALID (different methods using different hyperparams = unfair).
# -----------------------------------------------------------------------------
CKPT=/blue/mei.liu/lideyi/MAS-NAS/results/${HOSPITAL}/checkpoint_mlm/mlm_model.pt
RESULTS_DIR=/blue/mei.liu/lideyi/MAS-NAS/results/seed_${SEED}
HISTORY_ROOT=/blue/mei.liu/lideyi/MAS-NAS/results

COMMON_ARGS=(
    --hospital $HOSPITAL
    --task $TASK
    --max_params 4000000
    --flops_seq_len 512
    --ckpt_path $CKPT
    --results_dir $RESULTS_DIR
    --pretrain_epochs 100
    --pretrain_patience 5
    --embed_dim 256
    --depth 8
    --num_heads 8
    --mlp_ratio 8
    --finetune_epochs 30
    --finetune_patience 5
    --top_k_epochs 3
    --batch_size 64
    --lr 2e-4
    --weight_decay 1e-2
    --max_grad_norm 1.0
    --drop_rate 0.1
    --attn_drop_rate 0.1
    --drop_path_rate 0.1
    --seed $SEED
    --num_workers 4
    --cudnn_benchmark
)

# --history_root is consumed only by mas_search.py (Layer 1 / Layer 2 prior
# loading paths). Baselines 0-4 don't define this argparse flag and would
# crash with "unrecognized arguments" if it leaked through COMMON_ARGS. Keep
# it scoped to the mas variants only.
MAS_EXTRA=(--history_root $HISTORY_ROOT)

case "$METHOD" in
  baseline0)
    python baselines/baseline0.py "${COMMON_ARGS[@]}" --budget 50
    ;;
  baseline1)
    python baselines/baseline1.py "${COMMON_ARGS[@]}" --budget 50 \
        --population_num 8 --select_num 4 --mutation_num 4 --crossover_num 4 --m_prob 0.3
    ;;
  baseline2)
    python baselines/baseline2.py "${COMMON_ARGS[@]}" --budget 50 \
        --model google/gemini-2.5-flash-lite
    ;;
  baseline3)
    python baselines/baseline3.py "${COMMON_ARGS[@]}" --budget 50 \
        --model google/gemini-2.5-flash-lite --temperature 0.7 \
        --n_niches 16 --random_init_frac 0.3 --mutation_prob 0.85 --temp_jitter 0.1 --top_n_select 3
    ;;
  baseline4)
    python baselines/baseline4.py "${COMMON_ARGS[@]}" --budget 50 \
        --model google/gemini-2.5-flash-lite \
        --navigator_temperature 0.7 --generator_temperature 0.7 --candidates_per_iter 3
    ;;
  mas)
    python mas_search.py "${COMMON_ARGS[@]}" "${MAS_EXTRA[@]}" --budget 50
    ;;
  mas_loto)
    python mas_search.py "${COMMON_ARGS[@]}" "${MAS_EXTRA[@]}" --budget 50 --exclude_exact_task_from_history
    ;;
  mas_cold)
    python mas_search.py "${COMMON_ARGS[@]}" "${MAS_EXTRA[@]}" --budget 50 --no_history
    ;;
  mas_layer1_only)
    python mas_search.py "${COMMON_ARGS[@]}" "${MAS_EXTRA[@]}" --budget 50 --no_meta_regression
    ;;
  *)
    echo "ERROR: Unknown METHOD '$METHOD' (TSV line $SLURM_ARRAY_TASK_ID)"
    exit 1
    ;;
esac

date
echo "DONE: index=$SLURM_ARRAY_TASK_ID seed=$SEED hospital=$HOSPITAL task=$TASK method=$METHOD"
